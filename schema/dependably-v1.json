{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dependably.dev/schema/dependably-v1.json",
  "title": "Dependably suite configuration (.dependably)",
  "description": "Shared config for the Dependably tools (npm-check, nucheck, pycheck, cslint, codemetrics). See docs/dependably-config-spec.md for the normative runtime contract; this schema is for editor tooling only.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "integer",
      "description": "Config format version. Currently 1; absent is treated as 1.",
      "minimum": 1
    },
    "common": {
      "$ref": "#/$defs/section",
      "description": "Base settings shared by every tool. Merged under each tool's own section (scalars overridden, rules merged per id, list keys unioned)."
    },
    "npm-check": { "$ref": "#/$defs/section" },
    "nucheck": { "$ref": "#/$defs/section" },
    "pycheck": { "$ref": "#/$defs/section" },
    "cslint": { "$ref": "#/$defs/section" },
    "codemetrics": { "$ref": "#/$defs/section" },
    "npm": {
      "$ref": "#/$defs/section",
      "deprecated": true,
      "description": "Deprecated alias for the 'npm-check' section."
    },
    "nuget": {
      "$ref": "#/$defs/section",
      "deprecated": true,
      "description": "Deprecated alias for the 'nucheck' section."
    },
    "python": {
      "$ref": "#/$defs/section",
      "deprecated": true,
      "description": "Deprecated alias for the 'pycheck' section."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "object",
          "description": "Map of rule id to severity or [severity, options].",
          "additionalProperties": { "$ref": "#/$defs/ruleEntry" }
        },
        "exceptions": {
          "type": "array",
          "description": "Targeted suppression of specific findings so they do not gate the run.",
          "items": { "$ref": "#/$defs/exception" }
        },
        "exclude": {
          "type": "array",
          "description": "Glob patterns the tool skips entirely.",
          "items": { "type": "string" }
        },
        "failOn": { "$ref": "#/$defs/failOn" },
        "allowedRegistryHosts": {
          "type": "array",
          "description": "Trusted registry hostnames (bare hosts, compared case-insensitively).",
          "items": { "type": "string" }
        },
        "allowedLocalFeeds": {
          "type": "array",
          "description": "Trusted repo-local package feeds (nucheck).",
          "items": { "type": "string" }
        },
        "maxWarnings": {
          "type": "integer",
          "deprecated": true,
          "description": "Deprecated (npm-check). Use failOn.count."
        },
        "strict": {
          "type": "boolean",
          "deprecated": true,
          "description": "Deprecated (cslint). Use failOn.severity: \"warning\"."
        },
        "scan": {
          "type": "object",
          "deprecated": true,
          "description": "Deprecated (cslint). Use rules: { OP004|OP005|OP006: \"off\" }.",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "additionalProperties": true
    },
    "ruleSeverity": {
      "type": "string",
      "enum": ["error", "warn", "off"]
    },
    "ruleEntry": {
      "oneOf": [
        { "$ref": "#/$defs/ruleSeverity" },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/ruleSeverity" },
            { "type": "object" }
          ]
        }
      ]
    },
    "failOn": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string",
          "description": "Gate when any unsuppressed finding is at or above this ladder level.",
          "enum": ["critical", "high", "moderate", "low", "info", "error", "warning", "warn"]
        },
        "count": {
          "type": "integer",
          "description": "Gate when unsuppressed warning-class findings exceed this budget.",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "description": "Rule id the suppressed finding reports under (from a tool's rule registry). No wildcard."
        },
        "package": {
          "type": "string",
          "description": "Package/dependency name (case-insensitive). Optional @<version> suffix pins to an exact version."
        },
        "path": {
          "type": "string",
          "description": "Glob for the finding's file path, relative to the config file's directory."
        },
        "symbol": {
          "type": "string",
          "description": "Code location: Type or Type.Member."
        },
        "id": {
          "type": "string",
          "description": "Specific finding identifier (advisory id such as GHSA/CVE/OSV, or a tool finding-code instance)."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Required audit trail for the suppression."
        },
        "expires": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "YYYY-MM-DD. After this date the exception is inert and warned about."
        }
      },
      "required": ["rule", "reason"],
      "anyOf": [
        { "required": ["package"] },
        { "required": ["path"] },
        { "required": ["symbol"] },
        { "required": ["id"] }
      ],
      "additionalProperties": false
    }
  }
}
